generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Locale {
  pl
  en
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ScentFamily {
  WOODY
  FLORAL
  CITRUS
  GOURMAND
  FRESH
  SPICY
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum ShippingMethod {
  COURIER
  PARCEL_LOCKER
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String
  name           String
  role           Role                 @default(CUSTOMER)
  locale         Locale               @default(pl)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       Session[]
  addresses      Address[]
  orders         Order[]
  passwordResets PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  line1      String
  line2      String   @default("")
  postalCode String
  city       String
  country    String   @default("PL")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Product {
  id           String               @id @default(cuid())
  slug         String               @unique
  family       ScentFamily
  accentColor  String
  status       ProductStatus        @default(DRAFT)
  featured     Boolean              @default(false)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProductTranslation[]
  variants     ProductVariant[]
  images       ProductImage[]

  @@index([status, sortOrder])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  tagline     String
  description String
  mood        String
  ritual      String
  notesTop    String[]
  notesHeart  String[]
  notesBase   String[]

  @@unique([productId, locale])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String      @unique
  weightGrams Int
  burnHours   Int
  priceGrosze Int
  stock       Int         @default(0)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([productId])
}

enum ImageRole {
  COLOR
  NEUTRAL
  TOP
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  role      ImageRole @default(COLOR)
  url       String
  altPl     String
  altEn     String
  width     Int
  height    Int
  sortOrder Int       @default(0)

  @@unique([productId, role])
  @@index([productId])
}

model Order {
  id                    String         @id @default(cuid())
  number                String         @unique
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String
  locale                Locale
  status                OrderStatus    @default(PENDING)
  subtotalGrosze        Int
  shippingGrosze        Int
  totalGrosze           Int
  currency              String         @default("PLN")
  shippingMethod        ShippingMethod
  parcelLockerCode      String?
  shipFirstName         String
  shipLastName          String
  shipLine1             String
  shipLine2             String         @default("")
  shipPostalCode        String
  shipCity              String
  shipCountry           String         @default("PL")
  shipPhone             String
  notes                 String         @default("")
  trackingNumber        String?
  stripePaymentIntentId String?        @unique
  paidAt                DateTime?
  confirmationSentAt    DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  items                 OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName     String
  variantLabel    String
  sku             String
  unitPriceGrosze Int
  quantity        Int

  @@index([orderId])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
